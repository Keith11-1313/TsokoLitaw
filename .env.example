# Supabase public connection details (Project Connect dialog)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase secret key (sb_secret_...). Never expose this value to the browser.
SUPABASE_SECRET_KEY=

# Local-only bootstrap input for `npm run admin:bootstrap`.
# Keep the real identity in .env.local, never in source control or Vercel.
INITIAL_ADMIN_EMAIL=

# Protects scheduled server jobs such as the 90-day account-deactivation processor.
CRON_SECRET=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
