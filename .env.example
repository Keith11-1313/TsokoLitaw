# Public application configuration.
# On Vercel, replace localhost with the canonical deployed domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase public connection details from the Project Connect dialog.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase secret key (sb_secret_...).
# Never rename this with NEXT_PUBLIC_ or expose it to browser code.
SUPABASE_SECRET_KEY=

# Server-only random secret used by Vercel Cron to authorize scheduled jobs.
CRON_SECRET=

# Local .env.local only. Do not add this variable to Vercel.
# The approved Google account must sign in once before running npm run admin:bootstrap.
INITIAL_ADMIN_EMAIL=

# Phase 10 — PayMongo Test Mode.
# Use sk_test_ and pk_test_ credentials only until live payments are approved.
# Keep the secret key and webhook secret server-only.
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=

# Add after creating the PayMongo test webhook endpoint.
PAYMONGO_WEBHOOK_SECRET=

# Later email phase — Resend. Leave blank until that phase begins.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM_ADDRESS=
