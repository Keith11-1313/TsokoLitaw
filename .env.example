# Supabase public connection details (Project Connect dialog)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase secret key (sb_secret_...). Never expose this value to the browser.
SUPABASE_SECRET_KEY=

# Deployment-only bootstrap input. Keep the real identity in .env.local/Vercel,
# not in source control. The value is used only by a controlled admin setup step.
INITIAL_ADMIN_EMAIL=

# Protects scheduled server jobs such as the 90-day account-deletion processor.
CRON_SECRET=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
