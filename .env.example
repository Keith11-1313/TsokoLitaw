# Public application configuration.
# Dev Vercel project: https://tsokolitaw.vercel.app
# Production Vercel project: https://www.tsokolitaw.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase public connection details from the Project Connect dialog.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase secret key (sb_secret_...).
# Never rename this with NEXT_PUBLIC_ or expose it to browser code.
SUPABASE_SECRET_KEY=

# Server-only random secret shared with Supabase Cron to authorize scheduled jobs.
# Use different values in Dev and Production.
CRON_SECRET=

# Local .env.local only. Do not add this variable to Vercel.
# The approved Google account must sign in once before running npm run admin:bootstrap.
INITIAL_ADMIN_EMAIL=

# PayMongo remains in test mode until the final Phase 13 live-payment approval.
# Dev uses sk_test_ / pk_test_ and its own webhook endpoint and signing secret.
# Never copy Dev credentials or webhook secrets into the Production project.
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=

# Add after creating the PayMongo test webhook endpoint.
PAYMONGO_WEBHOOK_SECRET=

# Base64-encoded 32-byte AES key for manual refund fallback account details.
# Generate once per environment and store only in .env.local / Vercel secrets.
REFUND_DESTINATION_ENCRYPTION_KEY=

# Transactional email. Keep API and webhook secrets server-only, and use a
# separate signed webhook endpoint/secret for each deployed environment.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM_ADDRESS="TsokoLitaw <orders@updates.tsokolitaw.com>"
