{
  "name": "tsokolitaw",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/prepare-receipt-ocr.mjs",
    "prebuild": "node scripts/prepare-receipt-ocr.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "load:smoke": "k6 run -e PROFILE=smoke tests/performance/storefront.js",
    "load:100": "k6 run -e PROFILE=capacity tests/performance/storefront.js",
    "skeleton:build": "boneyard-js build http://localhost:3000/boneyard-preview",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:lint": "supabase db lint --level error",
    "db:test": "supabase test db",
    "db:types": "node scripts/generate-database-types.mjs",
    "db:lint:linked": "supabase db lint --linked --level error --fail-on error",
    "db:test:linked": "supabase test db --linked",
    "db:test:linked:cancellation": "supabase test db supabase/tests/database/003_cancellation.test.sql --linked",
    "admin:bootstrap": "node --env-file=.env.local scripts/bootstrap-admin.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "@tesseract.js-data/eng": "^1.0.0",
    "boneyard-js": "^1.9.0",
    "lucide-react": "^1.34.0",
    "next": "16.3.4",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.4",
    "svix": "^2.1.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "jsdom": "^27.0.0",
    "prettier": "^3.9.6",
    "supabase": "^2.116.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
